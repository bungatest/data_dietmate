# Database (pilih salah satu: DATABASE_URL atau parameter DB_*)
DATABASE_URL=postgresql://postgres:password@localhost:5432/dietmate_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dietmate_db
DB_USER=postgres
DB_PASSWORD=password

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS (untuk integrasi dengan frontend Next.js)
CORS_ORIGINS=["http://localhost:3000"]

# Standar & parameter nutrisi
# Pilihan BMI_STANDARD: "kemenkes" (default Kemenkes RI) atau "who"
BMI_STANDARD=kemenkes
NUTRITION_TOLERANCE_PCT=10
MAX_RECIPE_REPEATS=2

