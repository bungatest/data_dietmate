# true = gunakan mock auth dan data meal plan demo (tanpa autentikasi server)
# false = kirim request auth dan meal plan ke backend FastAPI
NEXT_PUBLIC_USE_MOCK_API=true

# Isi setelah backend FastAPI tersedia.
# Contoh lokal: http://localhost:8000
# Contoh production: https://api-domain-kelompok-kamu.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
